# API clients must send: Authorization: Bearer <MERCHANT_AGENT_API_KEY>
MERCHANT_AGENT_API_KEY=replace-with-a-random-token-at-least-24-characters
OPENAI_API_KEY=replace-with-your-openai-api-key

MERCHANT_AGENT_HOST=127.0.0.1
MERCHANT_AGENT_PORT=8090
MERCHANT_AGENT_MODEL=gpt-6-luna
MERCHANT_AGENT_OPENAI_TIMEOUT=60
MERCHANT_AGENT_MAX_BODY_BYTES=65536

