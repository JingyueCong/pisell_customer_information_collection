# API clients must send: Authorization: Bearer <MERCHANT_AGENT_API_KEY>
MERCHANT_AGENT_API_KEY=replace-with-a-random-token-at-least-24-characters
OPENAI_API_KEY=replace-with-your-openai-api-key

MERCHANT_AGENT_HOST=127.0.0.1
MERCHANT_AGENT_PORT=8090
MERCHANT_AGENT_MODEL=gpt-6-luna
MERCHANT_AGENT_OPENAI_TIMEOUT=60
# Allows authenticated local requests containing up to 6 MB of screenshot bytes as base64.
MERCHANT_AGENT_MAX_BODY_BYTES=10485760

# Shared Feishu knowledge store. Leave disabled for preview-only mode.
MERCHANT_AGENT_KNOWLEDGE_STORE=disabled
PISELL_P1_ROOT=/absolute/path/to/P1
PISELL_FEISHU_DATA_LAYER_CONFIG=/absolute/path/to/P1/config/feishu-data-layer.json
LARK_CLI=/absolute/path/to/lark-cli-or-wrapper

# Optional read-only customer binding through Feishu Project / Meegle CRM.
# When enabled, a unique CRM match is required before a knowledge-base save.
MERCHANT_AGENT_CRM_RESOLVER=disabled
MERCHANT_AGENT_CRM_TIMEOUT=20
# 推荐：复用同一台 Mac mini 上工单 Agent 的已验证 Meegle 身份
TICKET_BRIDGE_URL=http://127.0.0.1:8787
TICKET_BRIDGE_TOKEN=
MEEGLE_BIN=/absolute/path/to/meegle
MEEGLE_PROFILE=
MEEGLE_PROJECT_KEY=v2qint
MEEGLE_CRM_WORK_ITEM_TYPE=67df84a32e42950cb0195cba
MEEGLE_CRM_URL_TEMPLATE=https://project.feishu.cn/v2qint/crm/detail/{work_item_id}

# Feishu conversational app. Create a self-built app and keep these only in .env.
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
MERCHANT_AGENT_API_URL=http://127.0.0.1:8090
FEISHU_BOT_GROUP_ALLOWLIST=
FEISHU_BOT_SENDER_ALLOWLIST=
FEISHU_BOT_SESSION_TTL=604800
# Durable draft/recording state; the default is under ~/Library/Application Support/PiSell.
FEISHU_BOT_SESSION_STORE=
FEISHU_GROUP_SUMMARY_MESSAGE_THRESHOLD=20
FEISHU_GROUP_SUMMARY_IDLE_SECONDS=600
FEISHU_GROUP_SUMMARY_IDLE_MIN_MESSAGES=1
