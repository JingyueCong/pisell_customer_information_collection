# API clients must send: Authorization: Bearer <MERCHANT_AGENT_API_KEY>
MERCHANT_AGENT_API_KEY=replace-with-a-random-token-at-least-24-characters
OPENAI_API_KEY=replace-with-your-openai-api-key

MERCHANT_AGENT_HOST=127.0.0.1
MERCHANT_AGENT_PORT=8090
MERCHANT_AGENT_MODEL=gpt-6-luna
MERCHANT_AGENT_OPENAI_TIMEOUT=60
MERCHANT_AGENT_MAX_BODY_BYTES=65536

# Shared Feishu knowledge store. Leave disabled for preview-only mode.
MERCHANT_AGENT_KNOWLEDGE_STORE=disabled
PISELL_P1_ROOT=/absolute/path/to/P1
PISELL_FEISHU_DATA_LAYER_CONFIG=/absolute/path/to/P1/config/feishu-data-layer.json
LARK_CLI=/absolute/path/to/lark-cli-or-wrapper

# Feishu conversational app. Create a self-built app and keep these only in .env.
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
MERCHANT_AGENT_API_URL=http://127.0.0.1:8090
FEISHU_BOT_GROUP_ALLOWLIST=
FEISHU_BOT_SENDER_ALLOWLIST=
FEISHU_BOT_SESSION_TTL=14400
